{
  "manifest_version": 3,
  "name": "Sentinel Watcher 🌲",
  "version": "1.0",
  "description": "Monitorea tu uso de apps distractoras mientras trabajas en modo focus.",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "activeTab"
  ],
  "host_permissions": [
    "https://sentinel.marcosmorales.dev/**",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
